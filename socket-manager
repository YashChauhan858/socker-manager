import { io, Socket } from 'socket.io-client';

type SocketCallback = (...args: any[]) => void;

interface EventTracker {
  [event: string]: {
    [callbackId: string]: SocketCallback;
  };
}

/**
 * Static Socket Manager
 */
export class SocketManager {
  private static socket: Socket | null = null;

  private static eventTracker: EventTracker = {};

  private static reconnectTimeout: ReturnType<typeof setTimeout> | null = null;

  /**
   * Initialize socket connection
   */
  static init() {
    if (this.socket) return;

    this.socket = io({
      // auth: {
      //   token: localStorage.getItem('_qrc_o1')?.replace('1290381092438', ''),
      // },
    });

    this.socket.on('connect', () => {
      console.log('connected');
    });

    this.socket.on('disconnect', () => {
      console.log('disconnect');
      this.reconnect();
    });

    this.socket.on('connect_error', () => {
      console.log('connect_error');
      this.reconnect();
    });
  }

  /**
   * Reconnect socket
   */
  private static reconnect() {
    if (this.reconnectTimeout) return;

    console.log('reconnecting in 5s....');

    this.reconnectTimeout = setTimeout(() => {
      this.socket?.connect();

      this.reconnectAllEvents();

      this.reconnectTimeout = null;
    }, 5000);
  }

  /**
   * Re-register all socket listeners
   */
  private static reconnectAllEvents() {
    if (this.isEventTrackerEmpty()) return;

    for (const event in this.eventTracker) {
      for (const callbackId in this.eventTracker[event]) {
        const callback = this.eventTracker[event][callbackId];

        this.socket?.on(event, callback);
      }
    }
  }

  /**
   * Check if tracker is empty
   */
  private static isEventTrackerEmpty() {
    return Object.keys(this.eventTracker).length === 0;
  }

  /**
   * Check if event has callbacks
   */
  private static isEventEmpty(event: string) {
    return Object.keys(this.eventTracker[event] || {}).length === 0;
  }

  /**
   * Subscribe to socket event
   */
  static subscribe(
    event: string,
    callbackId: string,
    callback: SocketCallback,
  ) {
    this.init();

    if (!callback) {
      throw new Error('Please provide a callback function');
    }

    if (!this.eventTracker[event]) {
      this.eventTracker[event] = {};
    }

    this.eventTracker[event][callbackId] = callback;

    this.socket?.on(event, callback);
  }

  /**
   * Unsubscribe specific callback
   */
  static unsubscribe(event: string, callbackId: string) {
    const eventCallbacks = this.eventTracker[event];

    if (!eventCallbacks) {
      throw new Error(`Event (${event}) not registered`);
    }

    const callback = eventCallbacks[callbackId];

    if (!callback) {
      throw new Error(
        `Callback (${callbackId}) not registered under (${event})`,
      );
    }

    this.socket?.off(event, callback);

    delete eventCallbacks[callbackId];

    if (this.isEventEmpty(event)) {
      delete this.eventTracker[event];

      this.socket?.off(event);
    }
  }

  /**
   * Remove all listeners
   */
  static unsubscribeAll() {
    this.socket?.removeAllListeners();

    this.eventTracker = {};
  }

  /**
   * Emit socket event
   */
  static emit(event: string, data?: any) {
    if (!event) {
      throw new Error('Event name is required for socket event emission.');
    }

    this.init();

    if (data === undefined) {
      console.warn(`No data provided for socket event: ${event}`);

      this.socket?.emit(event);

      return;
    }

    this.socket?.emit(event, data);
  }

  /**
   * Disconnect socket completely
   */
  static disconnect() {
    this.socket?.disconnect();

    this.socket = null;

    this.eventTracker = {};
  }

  /**
   * Get raw socket instance if needed
   */
  static getSocket() {
    this.init();

    return this.socket;
  }
}
